<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Everforest Contrast</string>
  <key>author</key>
  <string>Derived from Everforest by sainnhe</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#fffbef</string>
        <key>foreground</key><string>#3d4c4f</string>
        <key>caret</key><string>#c65f18</string>
        <key>lineHighlight</key><string>#f8f5e4</string>
        <key>selection</key><string>#e4e8bd</string>
        <key>gutter</key><string>#fffbef</string>
        <key>gutterForeground</key><string>#68766d</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Comments</string>
      <key>scope</key><string>comment, punctuation.definition.comment</string>
      <key>settings</key><dict><key>foreground</key><string>#68766d</string><key>fontStyle</key><string>italic</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Keywords</string>
      <key>scope</key><string>keyword, storage.type, storage.modifier</string>
      <key>settings</key><dict><key>foreground</key><string>#b83f3d</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Operators and tags</string>
      <key>scope</key><string>keyword.operator, entity.name.tag, entity.name.label</string>
      <key>settings</key><dict><key>foreground</key><string>#c65f18</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Types</string>
      <key>scope</key><string>entity.name.type, entity.name.class, support.class, support.type</string>
      <key>settings</key><dict><key>foreground</key><string>#a87700</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Functions and strings</string>
      <key>scope</key><string>entity.name.function, support.function, string, constant.other.symbol</string>
      <key>settings</key><dict><key>foreground</key><string>#657a00</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Constants and escapes</string>
      <key>scope</key><string>constant, constant.character.escape, variable.interpolation</string>
      <key>settings</key><dict><key>foreground</key><string>#287f60</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Identifiers and properties</string>
      <key>scope</key><string>variable, entity.other.attribute-name, meta.object-literal.key</string>
      <key>settings</key><dict><key>foreground</key><string>#2c7198</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Numbers and language constants</string>
      <key>scope</key><string>constant.numeric, constant.language, variable.language, keyword.control.import</string>
      <key>settings</key><dict><key>foreground</key><string>#aa4d8e</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Headings</string>
      <key>scope</key><string>markup.heading, entity.name.section</string>
      <key>settings</key><dict><key>foreground</key><string>#c65f18</string><key>fontStyle</key><string>bold</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Links</string>
      <key>scope</key><string>markup.underline.link, string.other.link</string>
      <key>settings</key><dict><key>foreground</key><string>#2c7198</string><key>fontStyle</key><string>underline</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Inserted</string>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>#657a00</string><key>background</key><string>#e4e8bd</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Deleted and invalid</string>
      <key>scope</key><string>markup.deleted, invalid</string>
      <key>settings</key><dict><key>foreground</key><string>#b83f3d</string><key>background</key><string>#f8d4ca</string></dict>
    </dict>
  </array>
</dict>
</plist>
