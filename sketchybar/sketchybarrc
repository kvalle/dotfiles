#!/bin/bash

set -euo pipefail

PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar \
  position=top \
  height=32 \
  shadow=off

defaults=(
  icon.font="JetBrainsMono Nerd Font:Bold:14.0"
  label.font="JetBrainsMono Nerd Font:Medium:13.0"
  icon.padding_left=8
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=8
)
sketchybar --default "${defaults[@]}"

sketchybar --add item front_app left \
  --set front_app icon.font="sketchybar-app-font:Regular:14.0" icon.padding_right=6 script="$PLUGIN_DIR/front-app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock icon="󰥔" update_freq=30 script="$PLUGIN_DIR/clock.sh" \
  background.color=0x00000000 background.corner_radius=6 background.height=26 background.padding_left=6 background.padding_right=6 \
  click_script="open https://kalender.no" \
  --subscribe clock mouse.entered mouse.exited

sketchybar --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change system_woke

sketchybar --add item wifi right \
  --set wifi update_freq=10 script="$PLUGIN_DIR/wifi.sh" \
  background.color=0x00000000 background.corner_radius=6 background.height=26 background.padding_left=4 background.padding_right=4 \
  icon.padding_left=8 icon.padding_right=8 label.drawing=off \
  click_script="open x-apple.systempreferences:com.apple.Network-Settings" \
  --subscribe wifi wifi_change system_woke mouse.entered mouse.exited

sketchybar --add event bluetooth_status "com.apple.bluetooth.status" \
  --add event bluetooth_power_on "IOBluetoothHostControllerPoweredOnNotification" \
  --add event bluetooth_power_off "IOBluetoothHostControllerPoweredOffNotification"

sketchybar --add item bluetooth right \
  --set bluetooth update_freq=4 script="$PLUGIN_DIR/bluetooth.sh" \
  background.color=0x00000000 background.corner_radius=6 background.height=26 background.padding_left=4 background.padding_right=4 \
  icon.padding_left=8 icon.padding_right=8 label.drawing=off \
  click_script="open x-apple.systempreferences:com.apple.BluetoothSettings" \
  --subscribe bluetooth system_woke bluetooth_status bluetooth_power_on bluetooth_power_off mouse.entered mouse.exited

sketchybar --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" click_script="$PLUGIN_DIR/toggle-label.sh" \
  background.color=0x00000000 background.corner_radius=6 background.height=26 background.padding_left=4 background.padding_right=4 \
  icon.padding_left=8 icon.padding_right=4 \
  --subscribe battery system_woke power_source_change mouse.entered mouse.exited

sketchybar --add item mem right \
  --set mem update_freq=30 script="$PLUGIN_DIR/mem.sh" click_script="$PLUGIN_DIR/toggle-label.sh" \
  background.color=0x00000000 background.corner_radius=6 background.height=26 background.padding_left=4 background.padding_right=4 \
  icon.padding_left=8 icon.padding_right=8 label.drawing=off \
  --subscribe mem mouse.entered mouse.exited

sketchybar --add item cpu right \
  --set cpu update_freq=5 script="$PLUGIN_DIR/cpu.sh" click_script="$PLUGIN_DIR/toggle-label.sh" \
  background.color=0x00000000 background.corner_radius=6 background.height=26 background.padding_left=4 background.padding_right=4 \
  icon.padding_left=8 icon.padding_right=8 label.drawing=off \
  --subscribe cpu mouse.entered mouse.exited

sketchybar --add event appearance_changed AppleInterfaceThemeChangedNotification \
  --add item appearance_listener left \
  --set appearance_listener drawing=off script="$PLUGIN_DIR/appearance.sh" \
  --subscribe appearance_listener appearance_changed system_woke

# Re-apply battery color after theme change (appearance.sh resets '/.*/')
sketchybar --subscribe battery appearance_changed

sketchybar --update
