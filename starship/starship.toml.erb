# Generated by scripts/generate-starship-configs.rb. Do not edit directly.
# Starship prompt configuration for <%= description %>
# Docs: https://starship.rs/config/

command_timeout = 1000
palette = "<%= palette_name %>"
add_newline = true

format = """
$directory\
([░▒▓](fg:<%= git_surface %> bg:<%= directory_surface %>)$git_branch$git_status$git_state[ ](bg:<%= git_surface %>)[](fg:<%= git_surface %>) )\
$python\
${custom.uv_python}\
$java\
$nodejs\
$kotlin\
$kubernetes\
$azure\
$hostname\
$shlvl\
$jobs\
$status\
$cmd_duration\
$line_break\
$character"""

right_format = "$battery"

[character]
format = "$symbol "
success_symbol = "[❯](bold teal)"
error_symbol = "[❯](bold maroon)"

[directory]
truncation_length = 0
truncate_to_repo = true
format = "[](fg:<%= directory_surface %>)[ 󰉋 $path$read_only ]($style)[](fg:<%= directory_surface %>) "
repo_root_format = "[](fg:<%= directory_surface %>)[ 󰉋 $before_root_path$repo_root$path$read_only ]($style)"
style = "bold fg:<%= directory_foreground %> bg:<%= directory_surface %>"
repo_root_style = "bold fg:<%= directory_foreground %> bg:<%= directory_surface %>"

[git_branch]
format = "[ $symbol$branch(:$remote_branch)]($style)"
symbol = " "
style = "bold fg:<%= git_branch_foreground %> bg:<%= git_surface %>"

[git_status]
format = '([ $all_status$ahead_behind]($style))'
style = "bold fg:<%= git_status_foreground %> bg:<%= git_surface %>"
conflicted = "≠"
ahead = "↑"
behind = "↓"
diverged = "↕"
up_to_date = ""
untracked = "?"
stashed = '\$'
modified = "•"
staged = "+"
renamed = "→"
deleted = "×"
typechanged = "~"

[git_state]
format = "[ $state( $progress_current/$progress_total)]($style)"
style = "bold fg:<%= git_state_foreground %> bg:<%= git_surface %>"

[status]
disabled = false
format = "[$symbol$status]($style) "
symbol = "󰅙 "
style = "<%= secondary_style %>red"

[hostname]
ssh_only = true
format = "[@$hostname]($style) "
style = "<%= secondary_style %>lavender"

[shlvl]
disabled = false
threshold = 3
format = "[󰆍↳]($style) "
style = "<%= secondary_style %>cyan"

[jobs]
format = "[&·$number]($style) "
number_threshold = 1
style = "<%= secondary_style %>cyan"

[cmd_duration]
min_time = 2000
format = "[󰔟 $duration]($style) "
style = "<%= secondary_style %>yellow"

[battery]
format = "[$symbol$percentage]($style) "

[[battery.display]]
threshold = 40
style = "<%= secondary_style %>red"

[python]
format = '[${symbol}(${version} )(\($virtualenv\) )]($style)'
symbol = " "
style = "<%= secondary_style %>peach"

[custom.uv_python]
command = '''
dir=$PWD
git_root=$(git rev-parse --show-toplevel 2>/dev/null)

while true; do
  if [[ -f "$dir/uv.lock" ]]; then
    uv_version=$(uv python find --project "$dir" --show-version --no-python-downloads) || exit 1

    # Starship's Python module only scans the current directory. Fill in its
    # output when an uv project was found through an ancestor directory.
    python_module_active=false
    [[ -n "$VIRTUAL_ENV" ]] && python_module_active=true
    for marker in requirements.txt .python-version pyproject.toml Pipfile tox.ini setup.py __init__.py; do
      [[ -f "$PWD/$marker" ]] && python_module_active=true
    done
    python_files=($PWD/*.(py|ipynb)(N))
    (( $#python_files > 0 )) && python_module_active=true

    if $python_module_active; then
      print -r -- "(uv → $uv_version)"
    else
      for python_command in python python3 python2; do
        if command -v "$python_command" >/dev/null; then
          global_version=$($python_command --version 2>&1)
          print -r -- " v${global_version#Python } (uv → $uv_version)"
          break
        fi
      done
    fi
    exit
  fi

  [[ "$dir" == "$git_root" || "$dir" == / ]] && exit 1
  dir=${dir:h}
done
'''
when = true
format = '[$output](<%= secondary_style %>peach) '
shell = ["zsh", "--no-rcs"]

[java]
format = '[${symbol}(${version} )]($style)'
symbol = " "
style = "<%= secondary_style %>peach"

[nodejs]
format = '[${symbol}(${version})]($style)([ \(!= $engines_version\)](<%= secondary_style %>red)) '
symbol = "󰎙 "
style = "<%= secondary_style %>peach"
not_capable_style = "<%= secondary_style %>peach"

[kotlin]
symbol = " "
style = "<%= secondary_style %>peach"
format = '[${symbol}(${version} )]($style)'

[kubernetes]
disabled = true
format = '[$symbol$context( \($namespace\))]($style) '

[azure]
disabled = true
format = '[$symbol($subscription)]($style) '

<%= palette %>
