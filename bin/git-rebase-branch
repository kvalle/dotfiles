#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# git-rebase-branch – interactive rebase of every commit on the branch
# ---------------------------------------------------------------------------

_c_bold=$'\e[1m'
_c_dim=$'\e[2m'
_c_reset=$'\e[0m'
_c_green=$'\e[32m'
_c_yellow=$'\e[33m'

print_help() {
  cat <<EOF
${_c_bold}git rebase-branch${_c_reset} ${_c_dim}–${_c_reset} interactive rebase of every commit on the branch

Finds the branch point from a base branch (main/master) and starts an
interactive rebase from there. Useful for squashing, reordering, or
editing commits before merging.

${_c_bold}Usage:${_c_reset}
  ${_c_green}git rebase-branch${_c_reset}
  ${_c_green}git rebase-branch${_c_reset} ${_c_yellow}<base-branch>${_c_reset}

${_c_bold}Arguments:${_c_reset}
  ${_c_yellow}<base-branch>${_c_reset}       The branch to rebase against ${_c_dim}(default: main or master)${_c_reset}
  ${_c_yellow}-h${_c_reset}                  Show this help text

${_c_bold}Example:${_c_reset}
  ${_c_green}git rebase-branch${_c_reset}              ${_c_dim}Rebase every commit since branching from main/master${_c_reset}
  ${_c_green}git rebase-branch${_c_reset} ${_c_yellow}develop${_c_reset}      ${_c_dim}Rebase every commit since branching from develop${_c_reset}
EOF
}

case "${1:-}" in
  -h|--help) print_help; exit 0 ;;
esac

base=${1:-$(git show-ref --quiet refs/heads/main && echo main || echo master)}
git rebase -i "$(git merge-base HEAD "$base")"
