#!/usr/bin/env bash
set -euo pipefail

skip_tests=true
module=""
test_filter=""

print_help() {
  cat <<'EOF'
mci · run 'mvn clean install' with support for module builds and single tests

Usage:
  mci                              # Full build, without tests
  mci -t                           # Full build, with tests
  mci <module>                     # Module build, without tests
  mci <module> -t                  # Module build, with all tests
  mci <module> <Test>              # Run a single test class
  mci <module> <Test#method>       # Run a single test method

Flags:
  -t, --test              Run tests
  -h, --help              Show this help

Test filter examples:
  mci dpost-web-server SendForsendelseConcurrencyIT
  mci dpost-web-server 'SendForsendelseConcurrencyIT#methodName'
  mci dpost-web-server 'SendForsendelseConcurrencyIT#samtidig_*'

When a test filter is given, tests run automatically (no need for -t):
  mvn clean install -pl <module> -am -Dtest='<filter>' -Dsurefire.failIfNoSpecifiedTests=false

EOF
}

# Argument parsing
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) print_help; exit 0 ;;
    -t|--test) skip_tests=false; shift ;;
    --) shift; break ;;
    -*) echo "Unknown flag: $1" >&2; exit 2 ;;
    *)  if [[ -z "$module" ]]; then
          module="$1"; shift
        elif [[ -z "$test_filter" ]]; then
          test_filter="$1"; shift
        else
          echo "Too many arguments." >&2; exit 2
        fi
        ;;
  esac
done

# Validation
if [[ -n "$test_filter" && -z "$module" ]]; then
  echo "Error: a test filter requires a module." >&2
  exit 2
fi

# A test filter implies that tests should run
if [[ -n "$test_filter" ]]; then
  skip_tests=false
fi

# Run
cmd=(mvn clean install)
if [[ -n "$module" ]]; then
  cmd+=(-pl "$module" -am)
fi
if [[ "$skip_tests" == true ]]; then
  cmd+=(-DskipTests)
fi
if [[ -n "$test_filter" ]]; then
  cmd+=(-Dtest="$test_filter" -Dsurefire.failIfNoSpecifiedTests=false)
fi
exec "${cmd[@]}"
