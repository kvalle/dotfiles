#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# git-checkout-main – bytt til hovedbranchen (main eller master)
# ---------------------------------------------------------------------------

_c_bold=$'\e[1m'
_c_dim=$'\e[2m'
_c_reset=$'\e[0m'
_c_green=$'\e[32m'

print_help() {
  cat <<EOF
${_c_bold}git checkout-main${_c_reset} ${_c_dim}–${_c_reset} bytt til hovedbranchen (main eller master)

Finner og bytter til hovedbranchen i repoet. Sjekker main først,
deretter master. Feiler hvis ingen av dem finnes.

${_c_bold}Bruk:${_c_reset}
  ${_c_green}git checkout-main${_c_reset}

${_c_bold}Argumenter:${_c_reset}
  ${_c_green}-h${_c_reset}                   Vis denne hjelpeteksten

${_c_bold}Eksempel:${_c_reset}
  ${_c_green}git checkout-main${_c_reset}    ${_c_dim}Bytt til main (eller master hvis main ikke finnes)${_c_reset}
EOF
}

case "${1:-}" in
  -h|--help) print_help; exit 0 ;;
esac

if git show-ref --quiet refs/heads/main; then
  git checkout main
elif git show-ref --quiet refs/heads/master; then
  git checkout master
else
  echo 'Fant verken main eller master branch i repoet 🤷' >&2
  exit 1
fi
