#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# git-checkout-main – switch to the main branch (main or master)
# ---------------------------------------------------------------------------

_c_bold=$'\e[1m'
_c_dim=$'\e[2m'
_c_reset=$'\e[0m'
_c_green=$'\e[32m'

print_help() {
  cat <<EOF
${_c_bold}git checkout-main${_c_reset} ${_c_dim}–${_c_reset} switch to the main branch (main or master)

Finds and switches to the repository's main branch. Checks main first,
then master. Fails if neither exists.

${_c_bold}Usage:${_c_reset}
  ${_c_green}git checkout-main${_c_reset}

${_c_bold}Arguments:${_c_reset}
  ${_c_green}-h${_c_reset}                   Show this help text

${_c_bold}Example:${_c_reset}
  ${_c_green}git checkout-main${_c_reset}    ${_c_dim}Switch to main (or master if main does not exist)${_c_reset}
EOF
}

case "${1:-}" in
  -h|--help) print_help; exit 0 ;;
esac

if git show-ref --quiet refs/heads/main; then
  git checkout main
elif git show-ref --quiet refs/heads/master; then
  git checkout master
else
  echo 'Found neither a main nor a master branch in this repository 🤷' >&2
  exit 1
fi
