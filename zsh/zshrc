# ===========================================================================
# zsh configuration
# Sources the modules in zsh/ in the correct order.
# ===========================================================================

# Repository root, derived from this file so the repo can live anywhere.
# %N is the file being sourced; :A resolves it through the ~/.zshrc symlink to
# the real file in the repo, and :h:h strips zsh/zshrc off the end.
# $0 cannot be used here: in .zshrc it holds the shell name, not a path — it
# only becomes the file path inside the modules sourced below.
# Deliberately not exported, so scripts/lib/common.sh keeps deriving its own
# $DOTFILES from its location instead of inheriting this one.
typeset -g DOTFILES="${${(%):-%N}:A:h:h}"

# Homebrew (must be first — other tools depend on it)
# Both locations are checked so the config works on Apple Silicon and Intel:
# shellenv exports $HOMEBREW_PREFIX, which the modules below use instead of
# repeating the path. Nothing sets it if brew is missing entirely, so anything
# depending on it must handle an empty value.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$_brew" ] && eval "$("$_brew" shellenv)" && break
done
unset _brew

# Environment, PATH, and exports
source "$DOTFILES/zsh/environment.sh"

# Core shell behaviour
source "$DOTFILES/zsh/options.sh"
source "$DOTFILES/zsh/completions.sh"

# Shortcuts
source "$DOTFILES/zsh/aliases.sh"

# Version managers (jenv) — lazy-loaded
source "$DOTFILES/zsh/lazy-loaders.sh"

# Tool integrations (direnv, fzf, atuin, etc.)
source "$DOTFILES/zsh/tools.sh"

# Colors (shared ANSI variables used by functions below)
source "$DOTFILES/zsh/colors.sh"

# Custom functions
for f in "$DOTFILES"/zsh/functions/*.sh; do
  source "$f"
done

# Plugins (must be near end)
source "$DOTFILES/zsh/plugins.sh"

# Appearance must load after plugins that define mode-dependent styles.
source "$DOTFILES/zsh/appearance.sh"

# Prompt (must be last)
eval "$(starship init zsh)"

# Preserve the TAB widget installed by shell integrations, then wrap it.
_tab_widget=${${(z)"$(bindkey -M emacs '^I')"}[2]}
if [[ $_tab_widget != _complete_parent_path ]]; then
  typeset -g _complete_parent_path_fallback=$_tab_widget
fi
unset _tab_widget
bindkey -M emacs '^I' _complete_parent_path
