{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "theme": "auto",
  "notifications": false,
  "notificationMethod": "notifications_disabled",
  "defaultMode": "plan",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      ""
    ]
  },
  "spinnerTipsEnabled": false,
  "prefersReducedMotion": true,
  "permissions": {
    "deny": [
      "AskUserQuestion"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "# Requires tldraw offline: Develop > Install Agent Skills\nsh \"$HOME/skills/tldraw-offline/inject-server-context.sh\" SubagentStart"
          }
        ]
      }
    ]
  }
}
