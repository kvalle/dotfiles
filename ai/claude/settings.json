{
  "permissions": {
    "deny": [
      "AskUserQuestion"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/kjetil/skills/tldraw-offline/inject-server-context.mjs' SubagentStart"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "postman@claude-plugins-official": true
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      ""
    ]
  },
  "prefersReducedMotion": true,
  "theme": "auto",
  "notifications": false,
  "notificationMethod": "notifications_disabled",
  "defaultMode": "plan"
}
