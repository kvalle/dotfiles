{
  "$schema": "https://opencode.ai/config.json",
  // Oppdateringer håndteres av brew - false skrur av all upgrade-prompting
  "autoupdate": false,
  "instructions": ["~/.config/opencode/INSTRUCTIONS.md"],
  // LSP gir agenten IDE-lignende kodenavigasjon (go-to-def, references, diagnostics)
  "lsp": true
}
