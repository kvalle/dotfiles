[user]
	name = Kjetil Valle
	email = kjetil.valle@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA35JFxy9iET4iVoWDC0SGfWaOUbVSHg7673EKUVcUQP
[color]
	diff = auto
	status = auto
	branch = auto
[core]
	editor = vim +2
	pager = delta
	whitespace = fix,space-before-tab,tab-in-indent,trailing-space,blank-at-eof
	autocrlf = false
	hooksPath = ~/.githooks
[push]
	default = current
[github]
	user = kvalle
[alias]
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	wdiff = diff --color-words
	st = status -s
	rank = shortlog -sn --no-merges
	praise = blame
	s = switch
	r = restore
	co = checkout
	pr = pull --rebase
	pf = push --force-with-lease
	rb = rebase-branch
	hs = history-search
	cm = checkout-main
	amend-all = commit -a --amend --no-edit
	div = !git fetch --quiet && git log --oneline --left-right --decorate HEAD...@{u}
    sync-hard = !git fetch --quiet && git reset --hard @{u}
[hub]
	protocol = https
[rerere]
	enabled = true
[clean]
	requireForce = false
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
# Fallback-farger for diff uten delta (delta ignorerer disse)
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse
[delta]
	navigate = true
	line-numbers = true

[delta "catppuccin-macchiato"]
    dark = true
	# Catppuccin Macchiato
	syntax-theme = Catppuccin Macchiato
	plus-style = syntax "#1e4434"
	plus-emph-style = syntax "#2c6648"
	minus-style = syntax "#4b2234"
	minus-emph-style = syntax "#6e3347"

[delta "everforest-light-contrast"]
    light = true
    syntax-theme = everforest-light-contrast
    plus-style = syntax "#e4e8bd"
    plus-emph-style = syntax bold "#e4e8bd"
    minus-style = syntax "#f8d4ca"
    minus-emph-style = syntax bold "#f8d4ca"
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/dotfiles/git/allowed_signers
[commit]
	gpgsign = true
	template = ~/dotfiles/git/message

[includeIf "gitdir:~/dev/digipost/"]
	path = ~/dev/digipost/.gitconfig
[pull]
	ff = only
[fetch]
	prune = true
