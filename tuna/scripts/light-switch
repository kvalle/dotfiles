#!/bin/sh
# @tuna.name Light Switch
# @tuna.subtitle Toggle light and dark appearance
# @tuna.icon symbol:circle.lefthalf.filled
# @tuna.mode inline
# @tuna.input none

# Resolve the per-file symlink in ~/Library/Scripts before locating the repo.
script_path=$0
while [ -L "$script_path" ]; do
  link_target=$(readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path="$(dirname "$script_path")/$link_target" ;;
  esac
done
scripts_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
exec "$scripts_dir/../../bin/mac-light-switch"
