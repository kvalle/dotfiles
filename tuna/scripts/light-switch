#!/bin/sh
# @tuna.name Light Switch
# @tuna.subtitle Toggle light and dark appearance
# @tuna.icon symbol:circle.lefthalf.filled
# @tuna.mode inline
# @tuna.input none

# Tuna runs this via ~/Library/Scripts, a symlink to tuna/scripts in the repo.
# pwd -P resolves that symlink, so ../.. reaches the repo root wherever it is.
scripts_dir="$(cd "$(dirname "$0")" && pwd -P)"
exec "$scripts_dir/../../bin/mac-light-switch"
